NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_SITE_URL=https://recebify.vercel.app

# Lembretes por e-mail (ativação opcional; exige domínio verificado no Resend)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# Asaas de clientes finais: manter sandbox até validar a conta conectada.
# A integração permanece indisponível sem a chave de criptografia no backend.
ASAAS_CREDENTIAL_ENCRYPTION_KEY=

# Cobrança da assinatura do Recebify (plataforma): sandbox, não compartilhar com clientes.
ASAAS_PLATFORM_API_KEY=
ASAAS_PLATFORM_ENV=sandbox
ASAAS_PLATFORM_LIVE_BILLING_ENABLED=false
ASAAS_PLATFORM_WEBHOOK_TOKEN=
SAAS_STARTER_MONTHLY_BRL=
SAAS_PRO_MONTHLY_BRL=
